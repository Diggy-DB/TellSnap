# Copy to services/generator/.env and fill in your values.

# Redis (BullMQ job queue shared with the NestJS API)
REDIS_URL="redis://localhost:6379"

# Google Cloud (Firestore database + Cloud Storage for comic images)
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account-key.json"
GCS_BUCKET="your-bucket-name"

# Script expansion (optional: without it, a simple fallback script is used)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4-turbo-preview"

# Image generation (set at least one; tried in this order)
APIFREE_API_KEY=""        # Nano Banana Pro via apifree.ai
# OPENAI_API_KEY above also enables DALL-E 3
GOOGLE_AI_API_KEY=""      # Imagen 3 (or use GOOGLE_APPLICATION_CREDENTIALS for Vertex AI)
