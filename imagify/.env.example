# Copy to imagify/.env. The API and the generator both read this file.
# (apps/api/.env or services/generator/.env override it if present.)

# --- Required ---------------------------------------------------------------

# Auth: long random strings, e.g. `openssl rand -hex 32`. The API will not start without them.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# Google Cloud (Firestore database + Cloud Storage for comic images)
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/service-account-key.json"
GCS_BUCKET="your-bucket-name"

# Redis (BullMQ job queue shared by the API and the generator worker)
REDIS_URL="redis://localhost:6379"

# --- AI providers -------------------------------------------------------------

# Script expansion (optional: without it, a simple fallback script is used). Also enables DALL-E 3.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4-turbo-preview"

# Image generation: set at least one. Tried in order: apifree.ai, then DALL-E 3, then Imagen 3.
APIFREE_API_KEY=""
GOOGLE_AI_API_KEY=""

# --- Optional -----------------------------------------------------------------

PORT=4000                                   # API port
WEB_URL="http://localhost:3000"             # allowed CORS origin and password-reset link host
GENERATOR_API_URL="http://localhost:8080"   # generator FastAPI (script analysis)
NODE_ENV="development"                      # in development, password-reset links are logged
